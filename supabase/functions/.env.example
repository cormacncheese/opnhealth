# Copy to supabase/functions/.env for local development.
# On a hosted project set these with `supabase secrets set`.

# Shared secret that pg_cron uses to call the functions. Must match the
# `worker_secret` Vault secret (see supabase/seed.sql).
WORKER_SECRET=local-worker-secret

# Vercel AI Gateway key. Without it the agents cannot call a model.
AI_GATEWAY_API_KEY=

# Optional. Defaults shown.
# AGENT_MODEL=anthropic/claude-sonnet-5.5
# AGENT_MODEL_FAST=google/gemini-3.8-flash

# Optional. api.data.gov key for USDA FoodData Central (DEMO_KEY is rate limited).
FDC_API_KEY=
